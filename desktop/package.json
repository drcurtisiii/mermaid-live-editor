{
  "name": "mermaid-view-edit",
  "productName": "Mermaid View Edit",
  "version": "1.3.0",
  "description": "View and edit Mermaid diagrams - desktop edition of the Mermaid Live Editor",
  "author": "The Curtis Law Firm",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs"
  },
  "build": {
    "appId": "com.curtislawfirm.mermaidviewedit",
    "productName": "Mermaid View Edit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "web/**",
      "app.ico",
      "package.json",
      "!tests/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app.ico",
      "signAndEditExecutable": true
    }
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@44.4.5": true
  }
}
